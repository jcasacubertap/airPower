FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         100000;

deltaT          1;

writeControl    timeStep;

writeInterval   #calc "$endTime / 100" ;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    solverInfo
    {
        type            solverInfo;
        libs            ("libutilityFunctionObjects.so");
        writeResidualFields no;
        fields          ("U" "p");
    }

    yPlus
    {
        type                 yPlus;
        libs                 ("libfieldFunctionObjects.so");
        executeControl       writeTime;
        writeControl         writeTime;
    }

    vorticity
    {
        type            vorticity;
        libs            ("libfieldFunctionObjects.so");
        executeControl  writeTime;
        writeControl    writeTime;
    }

    writeMidPlane
    {
        type            coded;
        libs            ("libutilityFunctionObjects.so");
        name            writeMidPlane;
        executeControl  writeTime;
        writeControl    none;

        codeInclude
        #{
            #include "OFstream.H"
            #include "Pstream.H"
            #include <fstream>
        #};

        codeExecute
        #{
            const fvMesh& mesh = refCast<const fvMesh>(obr_);
            const volVectorField& U =
                mesh.lookupObject<volVectorField>("U");
            const volScalarField& p =
                mesh.lookupObject<volScalarField>("p");
            // Vorticity (volVectorField; only ω_z is meaningful on the 2D
            // mid-plane). Mirrors TTCP/AirfoilLECase output schema.
            const volVectorField& vort =
                mesh.lookupObject<volVectorField>("vorticity");
            const vectorField& C = mesh.C();

            // Read output format from inputParam
            IOdictionary inputParam
            (
                IOobject
                (
                    "inputParam", "constant", mesh,
                    IOobject::MUST_READ, IOobject::NO_WRITE
                )
            );
            const dictionary& d = inputParam.subDict("Upinlet");
            const word fmt = d.lookupOrDefault<word>("outputFormat", "csv");
            const bool wallExtrap = d.lookupOrDefault<bool>("wallExtrapolation", false);

            const scalar zTarget   = 0.0;
            const scalar zMatchTol = 1e-9;   // FP match for the chosen plane

            // Pick a SINGLE z-plane: the cell-center z closest to zTarget.
            // Picking the nearest cell-center z (rather than a tolerance
            // window |z|<zTol) guarantees exactly one plane even on 2D-
            // extruded meshes that put multiple cells inside any reasonable
            // tolerance window (e.g. 2 cells in z at ±dz/2).
            scalar zPlane = zTarget;
            {
                scalar bestDz = GREAT;
                forAll(C, cellI)
                {
                    const scalar zi = C[cellI].z();
                    const scalar dz = mag(zi - zTarget);
                    if (dz < bestDz)
                    {
                        bestDz = dz;
                        zPlane = zi;
                    }
                }
                reduce(zPlane, minOp<scalar>());  // deterministic agreement across procs
            }

            // Collect cells whose center is on this single plane (FP match).
            DynamicList<label> cells;
            forAll(C, cellI)
            {
                if (mag(C[cellI].z() - zPlane) < zMatchTol)
                {
                    cells.append(cellI);
                }
            }

            // ── Wall extrapolation: add wall face centres with u=v=w=0 ──
            // Wall pressure is taken from the BC value (pw[fi]). For the
            // standard zeroGradient pressure BC this equals the owner-cell
            // pressure — the same value OpenFOAM integrates for forces and
            // the same one already exported in wall-quantity outputs.
            // The previous 2-point linear extrapolation assumed a vertical
            // wall normal (dist = C[ci].y() - fy) and a tight x-column
            // filter; both assumptions break on the bump's sloped region,
            // producing the same kind of artifacts seen in AirfoilLECase.
            DynamicList<label> wallFaces;
            DynamicList<scalar> wallP;
            DynamicList<scalar> wallOmz;
            if (wallExtrap)
            {
                label patchID = mesh.boundaryMesh().findPatchID("plate");
                if (patchID >= 0)
                {
                    const polyPatch& pp = mesh.boundaryMesh()[patchID];
                    const vectorField faceCentres(pp.faceCentres());  // copy to avoid dangling ref
                    const fvPatchScalarField& pw = p.boundaryField()[patchID];
                    // BC value of vorticity at the wall — for a no-slip patch
                    // OpenFOAM computes this as curl(U) at the boundary face,
                    // which equals -∂u/∂y (the wall shear gradient).
                    const fvPatchVectorField& vortW = vort.boundaryField()[patchID];

                    forAll(faceCentres, fi)
                    {
                        if (mag(faceCentres[fi].z() - zPlane) > zMatchTol) continue;
                        wallFaces.append(fi);
                        wallP.append(pw[fi]);
                        wallOmz.append(vortW[fi].z());
                    }

                    Info<< "writeMidPlane: wall extrapolation — "
                        << wallFaces.size() << " wall faces added" << endl;
                }
            }

            // ── Parallel-safe write ─────────────────────────────────────
            // This function object runs on EVERY rank. Writing directly would
            // let all ranks clobber the same midPlane file (interleaved lines,
            // repeated headers, per-subdomain data) — unreadable downstream.
            // Instead each rank flattens its rows (8 scalars each), the master
            // gathers them, and the master is the sole writer. Interior rows
            // are kept separate from wall rows so the global file preserves the
            // serial "interior cells, then wall points" ordering. In serial
            // (nProcs = 1) this reduces to the original single-writer path.
            // Flatten this rank's rows (8 scalars each) into plain Lists, using
            // the same pre-sized/indexed idiom as the AirfoilLECase writer.
            List<scalar> locInterior(cells.size() * 8);
            forAll(cells, i)
            {
                const label ci = cells[i];
                locInterior[8*i + 0] = C[ci].x();
                locInterior[8*i + 1] = C[ci].y();
                locInterior[8*i + 2] = C[ci].z();
                locInterior[8*i + 3] = U[ci].x();
                locInterior[8*i + 4] = U[ci].y();
                locInterior[8*i + 5] = U[ci].z();
                locInterior[8*i + 6] = p[ci];
                locInterior[8*i + 7] = vort[ci].z();
            }

            List<scalar> locWall(wallFaces.size() * 8);
            if (wallExtrap)
            {
                const label patchID = mesh.boundaryMesh().findPatchID("plate");
                if (patchID >= 0)
                {
                    const vectorField fc(mesh.boundaryMesh()[patchID].faceCentres());
                    forAll(wallFaces, i)
                    {
                        const label fi = wallFaces[i];
                        locWall[8*i + 0] = fc[fi].x();
                        locWall[8*i + 1] = fc[fi].y();
                        locWall[8*i + 2] = fc[fi].z();
                        locWall[8*i + 3] = 0.0;
                        locWall[8*i + 4] = 0.0;
                        locWall[8*i + 5] = 0.0;
                        locWall[8*i + 6] = wallP[i];
                        locWall[8*i + 7] = wallOmz[i];
                    }
                }
            }

            // Gather every rank's rows onto the master (mirrors AirfoilLECase).
            List<List<scalar>> allInterior(Pstream::nProcs());
            List<List<scalar>> allWall(Pstream::nProcs());
            allInterior[Pstream::myProcNo()] = locInterior;
            allWall[Pstream::myProcNo()] = locWall;
            Pstream::gatherList(allInterior);
            Pstream::gatherList(allWall);

            if (Pstream::master())
            {
                const fileName outDir =
                    mesh.time().globalPath()/"postProcessing";
                mkDir(outDir);

                label totalRows = 0;
                forAll(allInterior, pr) totalRows += allInterior[pr].size() / 8;
                forAll(allWall, pr)     totalRows += allWall[pr].size() / 8;

                if (fmt == "binary")
                {
                    const fileName fpath = outDir/"midPlane.bin";
                    std::ofstream ofs(fpath, std::ios::binary);

                    int32_t nCols = 8;
                    int64_t nRows = totalRows;
                    ofs.write(reinterpret_cast<const char*>(&nCols), sizeof(nCols));
                    ofs.write(reinterpret_cast<const char*>(&nRows), sizeof(nRows));

                    forAll(allInterior, pr)
                    {
                        const List<scalar>& dl = allInterior[pr];
                        for (label r = 0; r < dl.size(); r += 8)
                        {
                            double row[8];
                            for (int c = 0; c < 8; ++c) row[c] = dl[r + c];
                            ofs.write(reinterpret_cast<const char*>(row), sizeof(row));
                        }
                    }
                    forAll(allWall, pr)
                    {
                        const List<scalar>& dl = allWall[pr];
                        for (label r = 0; r < dl.size(); r += 8)
                        {
                            double row[8];
                            for (int c = 0; c < 8; ++c) row[c] = dl[r + c];
                            ofs.write(reinterpret_cast<const char*>(row), sizeof(row));
                        }
                    }

                    Info<< "writeMidPlane: wrote " << totalRows
                        << " rows (binary) to " << fpath << endl;
                }
                else
                {
                    OFstream os(outDir/"midPlane.csv");
                    // midPlane is the base flow for downstream linear-stability
                    // analysis — write at max double precision (17 digits is the
                    // round-trip-safe value for IEEE 754 binary64).
                    os.precision(17);
                    os << "x,y,z,u,v,w,p,omz" << nl;

                    forAll(allInterior, pr)
                    {
                        const List<scalar>& dl = allInterior[pr];
                        for (label r = 0; r < dl.size(); r += 8)
                        {
                            os  << dl[r]   << "," << dl[r+1] << "," << dl[r+2] << ","
                                << dl[r+3] << "," << dl[r+4] << "," << dl[r+5] << ","
                                << dl[r+6] << "," << dl[r+7] << nl;
                        }
                    }
                    forAll(allWall, pr)
                    {
                        const List<scalar>& dl = allWall[pr];
                        for (label r = 0; r < dl.size(); r += 8)
                        {
                            os  << dl[r]   << "," << dl[r+1] << "," << dl[r+2] << ","
                                << dl[r+3] << "," << dl[r+4] << "," << dl[r+5] << ","
                                << dl[r+6] << "," << dl[r+7] << nl;
                        }
                    }

                    Info<< "writeMidPlane: wrote " << totalRows
                        << " rows (csv) to " << os.name() << endl;
                }
            }
        #};
    }
}


